<edgewatch-landing>
  <section class="landing-preview" aria-labelledby="_top">
    <div class="hero-atmosphere" aria-hidden="true"><div class="radar-ring" /><div class="radar-ring outer" /></div>
    <div class="hero-copy">
      <p class="hero-kicker"><span class="signal" /> Your network. No surprises.</p>
      <h1 id="_top" data-page-title>Know your surface.<br /><span>Notice what changes.</span></h1>
      <p class="hero-description">Scan your network. Learn what belongs. Get notified when something changes.</p>
      <div class="hero-actions">
        <a class="hero-button primary" href="/getting-started/installation/">Start monitoring <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
        <a class="hero-button secondary" href="/user-guide/scanning/">Explore the docs <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="hero-details" aria-label="EdgeWatch capabilities">
        <li>Self-hosted</li><li>TCP + UDP</li><li>Nmap-confirmed</li>
      </ul>
    </div>

    <figure class="demo-frame" aria-labelledby="demo-caption">
      <div class="demo-toolbar">
        <div class="window-dots" aria-hidden="true"><i /><i /><i /></div>
        <span class="demo-title">EdgeWatch</span>
        <span class="demo-badge"><i /> Walkthrough</span>
        <button type="button" class="playback-toggle" aria-label="Play walkthrough" hidden><span class="playback-icon" aria-hidden="true">▶</span> <span class="playback-label">Play</span></button>
      </div>
      <div class="demo-screen">
        <video muted loop playsinline preload="none" poster="/media/edgewatch-demo-poster.jpg" aria-label="EdgeWatch product walkthrough" aria-describedby="demo-caption">
          <source src="/media/edgewatch-demo.mp4" type="video/mp4" />
          <p><a href="/media/edgewatch-demo.mp4">Watch the EdgeWatch product tour</a>.</p>
        </video>
      </div>
      <figcaption id="demo-caption">
        <span><strong>Scan. Baseline. Detect.</strong></span>
      </figcaption>
      <p class="video-fallback" hidden role="status">The video could not load. <a href="https://github.com/user-attachments/assets/ddff32e8-617a-477f-b9b7-8681dbc25b82">Watch it on GitHub</a>.</p>
    </figure>
  </section>

  <div class="workflow" aria-label="How EdgeWatch works">
    <div><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4" /><path d="M12 12l5-5" /></svg></span><div><span class="workflow-number">01 / OBSERVE</span><strong>Scan every edge.</strong><p>IPs, CIDRs, and DNS names.<br />On your schedule.</p></div></div>
    <div><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8l8-4 8 4-8 4-8-4Zm0 5 8 4 8-4M4 18l8 4 8-4" /></svg></span><div><span class="workflow-number">02 / LEARN</span><strong>Define what belongs.</strong><p>Build an expected surface<br />from complete observations.</p></div></div>
    <div><span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h4l3-7 3 14 3-7h3" /></svg></span><div><span class="workflow-number">03 / RESPOND</span><strong>Catch the change.</strong><p>Review confirmed incidents.<br />Keep the original history.</p></div></div>
  </div>
</edgewatch-landing>

<script>
  class EdgeWatchLanding extends HTMLElement {
    video!: HTMLVideoElement
    motion = matchMedia('(prefers-reduced-motion: reduce)')
    observer?: IntersectionObserver
    videoVisible = true
    userPaused = false

    connectedCallback() {
      this.video = this.querySelector('video')!
      this.playbackButton.hidden = false
      this.playbackButton.addEventListener('click', this.togglePlayback)
      this.video.addEventListener('play', this.onVideoPlay)
      this.video.addEventListener('pause', this.onVideoPause)
      this.video.addEventListener('error', this.showVideoError)
      this.video.querySelector('source')!.addEventListener('error', this.showVideoError)
      this.motion.addEventListener('change', this.onMotionChange)
      document.addEventListener('visibilitychange', this.onVisibilityChange)
      this.updatePlayback()

      // Start muted and inline. Reduced-motion visitors keep the poster and
      // can opt into playback with the frame's play button.
      if (!this.motion.matches) {
        this.video.autoplay = true
        this.video.preload = 'auto'
        this.playIfAllowed()
      }
      this.observer = new IntersectionObserver(([entry]) => {
        this.videoVisible = entry.isIntersecting
        if (entry.isIntersecting) this.playIfAllowed()
        else this.video.pause()
      }, { threshold: 0 })
      this.observer.observe(this.video)
    }

    disconnectedCallback() {
      this.video.pause()
      this.observer?.disconnect()
      this.motion.removeEventListener('change', this.onMotionChange)
      document.removeEventListener('visibilitychange', this.onVisibilityChange)
      this.playbackButton.removeEventListener('click', this.togglePlayback)
      this.video.removeEventListener('play', this.onVideoPlay)
      this.video.removeEventListener('pause', this.onVideoPause)
      this.video.removeEventListener('error', this.showVideoError)
      this.video.querySelector('source')!.removeEventListener('error', this.showVideoError)
    }

    get playbackButton() { return this.querySelector<HTMLButtonElement>('.playback-toggle')! }

    togglePlayback = () => {
      this.userPaused = !this.video.paused
      if (this.video.paused) void this.video.play().catch(() => this.updatePlayback())
      else this.video.pause()
    }

    playIfAllowed = () => {
      if (!this.motion.matches && !this.userPaused && this.videoVisible && !document.hidden) {
        void this.video.play().catch(() => this.updatePlayback())
      }
    }

    onVideoPlay = () => { this.userPaused = false; this.updatePlayback() }
    onVideoPause = () => {
      // Preserve explicit pauses; scrolling away, hiding the tab, or enabling
      // reduced motion may pause automatically.
      if (this.videoVisible && !document.hidden && !this.motion.matches) this.userPaused = true
      this.updatePlayback()
    }

    updatePlayback = () => {
      const paused = this.video.paused
      this.playbackButton.setAttribute('aria-label', paused ? 'Play walkthrough' : 'Pause walkthrough')
      this.playbackButton.querySelector('.playback-icon')!.textContent = paused ? '▶' : 'Ⅱ'
      this.playbackButton.querySelector('.playback-label')!.textContent = paused ? 'Play' : 'Pause'
    }

    onMotionChange = () => {
      this.video.autoplay = !this.motion.matches
      if (this.motion.matches) this.video.pause()
      else this.playIfAllowed()
    }
    onVisibilityChange = () => { if (document.hidden) this.video.pause(); else this.playIfAllowed() }
    showVideoError = () => {
      this.querySelector<HTMLParagraphElement>('.video-fallback')!.hidden = false
      this.playbackButton.hidden = true
    }
  }

  if (!customElements.get('edgewatch-landing')) customElements.define('edgewatch-landing', EdgeWatchLanding)
</script>

