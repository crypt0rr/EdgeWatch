{
  "name": "edgewatch-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "node scripts/check-node-runtime.mjs && vite --host 127.0.0.1",
    "dev:prototype": "node scripts/check-node-runtime.mjs && vite --mode prototype --host 127.0.0.1",
    "build": "node scripts/check-node-runtime.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && node scripts/build-frontend.mjs",
    "lint": "node scripts/check-node-runtime.mjs && tsc --noEmit",
    "test": "node scripts/check-node-runtime.mjs && vitest run",
    "test:coverage": "node scripts/check-node-runtime.mjs && vitest run --coverage && node scripts/check-frontend-coverage.mjs && node --test scripts/coverage-gates.test.mjs scripts/playwright-config.test.mjs",
    "test:e2e": "node scripts/check-node-runtime.mjs && playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.12",
    "lucide-react": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
