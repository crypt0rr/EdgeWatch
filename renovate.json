{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": "Renovate owns version updates for Go, npm, Node.js, GoReleaser, Dockerfiles, Docker images, and GitHub Actions. GitHub security alerts remain enabled separately.",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "(?<depName>ca-certificates|gcompat|git|nmap|nmap-scripts|tzdata)=(?<currentValue>[0-9][0-9A-Za-z.+~-]*)"
      ],
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/{{{depName}}}",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["GORELEASER_VERSION:\\s*(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "goreleaser",
      "packageNameTemplate": "goreleaser/goreleaser",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["NODE_VERSION:\\s*(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "node",
      "packageNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["node"],
      "allowedVersions": "/^24\\./"
    }
  ]
}
